Screen {
    background: $surface;
}

#chat-log {
    height: 1fr;
    border: solid $primary;
    margin: 1 1 0 1;
    padding: 0 1;
}

#streaming-area {
    height: auto;
    max-height: 5;
    margin: 0 1;
    padding: 0 1;
    color: $text-muted;
}

#files-bar {
    height: 3;
    margin: 0 1;
}

#files-input {
    width: 100%;
}

#prompt-input {
    margin: 0 1;
}

#button-bar {
    height: 3;
    margin: 0 1;
    align: center middle;
}

Button {
    margin: 0 1;
}

#status-bar {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

/* Menu */
#menu-container {
    width: 30;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#menu-container > .menu-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#menu-container > Button {
    margin: 0 0 1 0;
}

/* Shared */
.section-title {
    text-style: bold;
    background: $primary-darken-1;
    padding: 0 1;
    margin: 1 0;
}

.label {
    padding: 0 1;
}

.input {
    margin: 0 1 1 1;
}

.horizontal {
    height: auto;
    margin: 1 1;
}

/* Agent screen */
#agent-config {
    height: auto;
    max-height: 14;
    margin: 0 1;
}

#tool-bar {
    height: auto;
    margin: 0 1;
    align: left middle;
}

#tool-bar > Button {
    min-width: 14;
}

#file-section {
    height: 3;
    margin: 0 1;
    display: none;
}

#file-section > #file-path {
    width: 1fr;
}

#max-steps-bar {
    height: auto;
    margin: 0 1;
}

#max-steps-bar > #max-steps {
    width: 8;
}

#agent-output {
    height: 1fr;
    border: solid $secondary;
    margin: 0 1;
}

#agent-input-bar {
    height: 3;
    margin: 0 1;
}

#agent-input-bar > #agent-prompt {
    width: 1fr;
}

#agent-status {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

/* Settings */
#settings-scroll {
    padding: 0 1;
}

.button-row {
    height: 3;
    margin: 1;
    align: center middle;
}

Checkbox {
    margin: 0 2;
}

/* File picker */
#file-tree {
    height: 1fr;
    margin: 1;
    border: solid $primary;
}

#fp-buttons {
    height: 3;
    margin: 0 1;
    align: center middle;
}

#s-websocket {
    margin: 0 1;
}
