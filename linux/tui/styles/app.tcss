Screen {
    background: $surface;
}

#chat-log {
    height: 1fr;
    border: solid $primary;
    margin: 1 1 0 1;
    padding: 0 1;
}

#prompt-input {
    margin: 1 1 0 1;
}

#files-bar {
    height: 3;
    margin: 0 1;
}

#files-input {
    width: 100%;
}

#button-bar {
    height: 3;
    margin: 0 1;
    align: center middle;
}

Button {
    margin: 0 1;
}

#status-bar {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

/* Menu */
#menu-container {
    width: 30;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#menu-container > .menu-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#menu-container > Button {
    margin: 0 0 1 0;
}

/* Shared */
.section-title {
    text-style: bold;
    background: $primary-darken-1;
    padding: 0 1;
    margin: 1 0;
}

.label {
    padding: 0 1;
}

.input {
    margin: 0 1 1 1;
}

.horizontal {
    height: auto;
    margin: 1 1;
}

#agent-output {
    height: 1fr;
    border: solid $secondary;
    margin: 1;
}

#settings-scroll {
    padding: 0 1;
}

.button-row {
    height: 3;
    margin: 1;
    align: center middle;
}

#agent-prompt {
    margin: 0 1;
}

Checkbox {
    margin: 0 2;
}
